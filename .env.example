# Edge Function secrets. Set with:  supabase secrets set --env-file .env --project-ref <ref>
# Never commit a real .env (it is in .gitignore).
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY (and SUPABASE_ANON_KEY) are injected into functions by Supabase. Do NOT set them yourself.
IP_SALT=replace-with-at-least-32-random-characters   # required: functions fail closed (HTTP 500) without it
ALLOWED_ORIGIN=https://your-site.vercel.app,https://your-domain.com   # comma-separated exact origins; unset = '*'
